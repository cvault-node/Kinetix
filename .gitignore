# ---------------------------------------------------------------------------
# Kinetix - .gitignore
# Solo se sube CODIGO FUENTE. Se excluyen artefactos de compilación,
# pruebas, registros y ficheros generados por el usuario.
# ---------------------------------------------------------------------------

# --- Artefactos de compilación / despliegue (NO subir) ---
/build/
/builds/
/build*/
/out/
/dist/
*.zip
*.7z
*.tar.gz
*.exe
*.dll
*.lib
*.pdb
*.obj
*.o
*.ilk
*.exp
*.idb
*.res
*.rc
*.manifest

# --- Qt / CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.user
*.user.*
*.qmake.stash
*.qmlproject.user
*.pro.user
CMakeUserPresets.json
install_manifest.txt

# --- NSIS / instaladores ---
*.nsi~ 
*.nsh~ 
/output/

# --- Scripts de pruebas / medida / compilación (NO subir) ---
*.ps1
*.bat
*.cmd
*.sh

# --- Registros y temporales (NO subir) ---
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- aqtinstall ---
aqtinstall/
*.7z
aqt*

# --- QtWebEngine runtime profiles (NO subir) ---
/.navegador_personal/
*.pak
QtWebEngine/

# --- Binarios varios ---
*.apk
*.app
*.dmg
*.so
*.dylib
*.a

# --- Editor / IDE ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
__pycache__/
